# Neon "pooled" connection string (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon "direct" connection string (same, without "-pooler") - used for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Used ONCE: the first sign-in on an empty database turns these two accounts into users
# (owner -> Administrator, viewer -> Viewer). After that, users are managed on the Users page.
ADMIN_USERNAME="khaled elbauomy"
APP_PASSWORD="change-me"
VIEWER_USERNAME="remoon milad"
VIEWER_PASSWORD="change-me-too"
# Random secret of at least 32 characters (signs the login cookie)
SESSION_SECRET="replace-with-a-long-random-string-of-32-plus-chars"

# Optional: "Sign in with Microsoft" (needs an app registration in ACT's Microsoft Entra ID; see the user guide).
# Leave empty to hide the button.
MS_ENTRA_TENANT_ID=""
MS_ENTRA_CLIENT_ID=""
MS_ENTRA_CLIENT_SECRET=""
# The public address of this app, used for the sign-in redirect, e.g. https://solo-scrum.vercel.app
APP_URL=""

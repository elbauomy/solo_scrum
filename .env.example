# Neon "pooled" connection string (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon "direct" connection string (same, without "-pooler") - used for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Owner account: can change everything. User name (can be changed) and password
ADMIN_USERNAME="khaled elbauomy"
APP_PASSWORD="change-me"
# View-only account: can look at everything but change nothing. If VIEWER_PASSWORD is empty this account cannot sign in
VIEWER_USERNAME="remoon milad"
VIEWER_PASSWORD="change-me-too"
# Random secret of at least 32 characters (signs the login cookie)
SESSION_SECRET="replace-with-a-long-random-string-of-32-plus-chars"

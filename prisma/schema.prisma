generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// System-wide settings. Always exactly one row with id = 1.
model Setting {
  id                      Int      @id @default(1)
  /// Working weekdays: 0 = Sunday ... 6 = Saturday
  workingDays             Int[]    @default([1, 2, 3, 4, 5])
  defaultDailyHours       Float    @default(8)
  defaultSprintLengthDays Int      @default(14)
  updatedAt               DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

model Squad {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String            @default("")
  /// Overrides the system default sprint length (days) for this squad's LOBs
  sprintLengthDays Int?
  lobs             LineOfBusiness[]
  memberships      SquadMembership[]
  standups         StandupEntry[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

/// A Line of Business (LOB) is the "project". Owned by exactly one squad.
model LineOfBusiness {
  id               String                @id @default(cuid())
  name             String                @unique
  description      String                @default("")
  squadId          String
  squad            Squad                 @relation(fields: [squadId], references: [id], onDelete: Restrict)
  /// Overrides the squad / system sprint length (days)
  sprintLengthDays Int?
  /// Short code used in item IDs, e.g. "RB" -> RB-12
  key              String                @unique
  /// Next item number to hand out in this LOB
  nextItemNumber   Int                   @default(1)
  /// Azure DevOps sync columns: kept but unused while the sync is switched off (it lives on the azure-devops-sync branch).
  /// Name of the Azure DevOps project this line syncs with (empty = not linked)
  adoProject       String?
  adoLastSyncAt    DateTime?
  /// Summary of the last sync (see SyncSummary in src/lib/ado-sync.ts)
  adoLastResult    Json?
  workItems        WorkItem[]
  sprints          Sprint[]
  releases         Release[]
  allocations      MemberLobAllocation[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([squadId])
}

/// Squad member. A name only - members do not log in.
model Member {
  id           String              @id @default(cuid())
  name         String
  role         String              @default("")
  active       Boolean             @default(true)
  memberships  SquadMembership[]
  leaves       Leave[]
  assignments  WorkItem[]
  sprintShares SprintMemberShare[]
  sprintPlans  SprintMemberPlan[]
  standups     StandupEntry[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

/// Hours per week a member gives to a squad.
model SquadMembership {
  id             String                @id @default(cuid())
  memberId       String
  squadId        String
  weeklyHours    Float
  member         Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  squad          Squad                 @relation(fields: [squadId], references: [id], onDelete: Restrict)
  /// Optional split of the weekly hours across the squad's lines of business
  lobAllocations MemberLobAllocation[]

  @@unique([memberId, squadId])
  @@index([squadId])
}

/// Full days off, start and end inclusive.
model Leave {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([memberId])
}

enum WorkItemType {
  EPIC
  FEATURE
  STORY
  BUG
  TASK
}

/// Story/Bug: NEW, APPROVED, COMMITTED, DONE. Task: NEW, IN_PROGRESS, DONE.
/// Epic/Feature progress is calculated from their children; their status stays NEW.
enum WorkItemStatus {
  NEW
  APPROVED
  COMMITTED
  IN_PROGRESS
  DONE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model WorkItem {
  id                 String             @id @default(cuid())
  type               WorkItemType
  /// Sequential number inside the LOB (shown as KEY-number)
  number             Int
  title              String
  description        String             @default("")
  acceptanceCriteria String             @default("")
  status             WorkItemStatus     @default(NEW)
  priority           Priority           @default(MEDIUM)
  /// Manual order among siblings (lower comes first)
  rank               Float              @default(0)
  lobId              String
  lob                LineOfBusiness     @relation(fields: [lobId], references: [id], onDelete: Restrict)
  parentId           String?
  parent             WorkItem?          @relation("WorkItemTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           WorkItem[]         @relation("WorkItemTree")
  /// Tasks only
  assigneeId         String?
  assignee           Member?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Tasks only
  estimateHours      Float?
  blocked            Boolean            @default(false)
  blockedReason      String             @default("")
  /// Set when status becomes DONE, cleared when it leaves DONE
  doneAt             DateTime?
  /// Stories, bugs and their tasks. Tasks follow their story; done tasks stay in the sprint they were finished in.
  sprintId           String?
  sprint             Sprint?            @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  history            WorkItemHistory[]
  commitments        SprintCommitment[]
  baseline           TaskBaseline?
  /// Azure DevOps work item id when this item is linked
  adoId              Int?
  /// What both sides agreed on at the last sync (see ItemSnapshot in src/lib/ado-sync.ts)
  adoSnapshot        Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([lobId, number])
  @@unique([lobId, adoId])
  @@index([parentId])
  @@index([assigneeId])
  @@index([lobId, type])
  @@index([sprintId])
}

/// One row per changed field, used for audit and for reports (cycle time, burndown).
model WorkItemHistory {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  /// created, title, status, priority, assignee, estimate, blocked, parent
  field      String
  oldValue   String?
  newValue   String?
  changedAt  DateTime @default(now())

  @@index([workItemId, changedAt])
  @@index([field, changedAt])
}

enum SprintState {
  PLANNED
  ACTIVE
  /// Work is on hold (for example the team was pulled onto something else). Tasks are not scheduled until it resumes.
  PAUSED
  CLOSED
}

/// A sprint belongs to one line of business. Sprints may overlap.
model Sprint {
  id          String              @id @default(cuid())
  lobId       String
  lob         LineOfBusiness      @relation(fields: [lobId], references: [id], onDelete: Restrict)
  name        String
  goal        String              @default("")
  startDate   DateTime            @db.Date
  endDate     DateTime            @db.Date
  state       SprintState         @default(PLANNED)
  /// Azure DevOps iteration path, e.g. SONATA/Release 6/Sprint 62 (backslashes)
  adoPath     String?
  releaseId   String?
  release     Release?            @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  startedAt   DateTime?
  closedAt    DateTime?
  /// Metrics saved when the sprint is closed (see SprintSummary in src/lib/analytics.ts)
  result      Json?
  items       WorkItem[]
  commitments SprintCommitment[]
  shares      SprintMemberShare[]
  plans       SprintMemberPlan[]
  pauses      SprintPause[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([lobId, startDate])
  @@index([releaseId])
}

/// Optional override: percent of a member's squad hours given to this sprint on days it overlaps other sprints.
model SprintMemberShare {
  id       String @id @default(cuid())
  sprintId String
  memberId String
  percent  Float
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sprintId, memberId])
}

/// Snapshot taken when a sprint starts. Rows for tasks hold their hours; rows for stories/bugs hold 0.
model SprintCommitment {
  id          String   @id @default(cuid())
  sprintId    String
  workItemId  String
  hours       Float    @default(0)
  /// Set when the sprint closes: story/bug was committed but not Done
  carriedOver Boolean  @default(false)
  sprint      Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  workItem    WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([sprintId, workItemId])
}

/// A release (deployment) belongs to one line of business and contains several of its sprints.
model Release {
  id           String              @id @default(cuid())
  lobId        String
  lob          LineOfBusiness      @relation(fields: [lobId], references: [id], onDelete: Restrict)
  name         String
  version      String              @default("")
  notes        String              @default("")
  targetDate   DateTime            @db.Date
  deployedDate DateTime?           @db.Date
  sprints      Sprint[]
  changes      ReleaseDateChange[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([lobId, targetDate])
}

model ReleaseDateChange {
  id        String   @id @default(cuid())
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  oldDate   DateTime @db.Date
  newDate   DateTime @db.Date
  reason    String   @default("")
  changedAt DateTime @default(now())

  @@index([releaseId, changedAt])
}

/// Dates the Scrum Master accepted for a task, so later slips are measured against them.
model TaskBaseline {
  id            String   @id @default(cuid())
  workItemId    String   @unique
  workItem      WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  baselineStart DateTime @db.Date
  baselineEnd   DateTime @db.Date
  acceptedAt    DateTime @default(now())
}

model StandupEntry {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  squadId   String
  memberId  String
  squad     Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// The member's status for the day, typed by hand
  status    String   @default("")
  /// The member is not working that day (leave, sick, day off...)
  off       Boolean  @default(false)
  offReason String   @default("")
  yesterday String   @default("")
  today     String   @default("")
  blockers  String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([date, squadId, memberId])
  @@index([squadId, date])
}

/// Hours per week a member reserves for one line of business inside a squad.
/// Whatever is left of the squad hours stays shared by all of the squad's lines of business.
model MemberLobAllocation {
  id           String          @id @default(cuid())
  membershipId String
  lobId        String
  weeklyHours  Float
  membership   SquadMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  lob          LineOfBusiness  @relation(fields: [lobId], references: [id], onDelete: Cascade)

  @@unique([membershipId, lobId])
  @@index([lobId])
}

/// A member's task capacity for one sprint, usually imported from the sprint planning sheet:
/// initial hours x availability, minus meetings, vacation, excuses and other fixed work. When present it replaces the calculated capacity.
model SprintMemberPlan {
  id              String @id @default(cuid())
  sprintId        String
  memberId        String
  availabilityPct Float  @default(100)
  initialHours    Float
  meetingsHours   Float  @default(0)
  vacationHours   Float  @default(0)
  excuseHours     Float  @default(0)
  /// Sprint done-definition tasks, scrum master tasks, spikes, awareness...
  otherHours      Float  @default(0)
  /// Hours left for story tasks (the sheet's "Final Buffer")
  capacityHours   Float
  sprint          Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  member          Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sprintId, memberId])
  @@index([memberId])
}

/// One period in which a sprint was on hold. The sprint is paused from `startDate` up to the day before `resumedOn`.
model SprintPause {
  id             String    @id @default(cuid())
  sprintId       String
  sprint         Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  startDate      DateTime  @db.Date
  /// First day the team works on the sprint again; empty while the sprint is still paused
  resumedOn      DateTime? @db.Date
  reason         String    @default("")
  /// Working days the end date was moved by when the sprint resumed (0 if it was not extended)
  extendedByDays Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([sprintId, startDate])
}
